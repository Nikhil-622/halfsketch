rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "dishasondur26@gmail.com",
          "jadhavnikhil622@gmail.com"
        ];
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.orderId == orderId
        && request.resource.data.status == "order_placed"
        && request.resource.data.paymentStatus == "unpaid";
      allow read: if isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email.lower());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status == "order_confirmed";
      allow delete: if false;
    }

    match /counters/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
