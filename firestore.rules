rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "dishasondur26@gmail.com",
          "jadhavnikhil622@gmail.com"
        ];
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.orderId == orderId
        && request.resource.data.status == "order_placed"
        && request.resource.data.paymentStatus == "unpaid";
      allow read: if isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email.lower());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "paymentStatus", "fulfillment"])
        && request.resource.data.status in ["order_placed", "order_confirmed", "order_cancelled"]
        && request.resource.data.paymentStatus in ["unpaid", "paid"]
        && (request.resource.data.status != "order_cancelled"
          || (resource.data.status == "order_placed" && resource.data.paymentStatus == "unpaid"))
        && (!("fulfillment" in request.resource.data) || request.resource.data.fulfillment in ["pending", "shipped"]);
      allow delete: if false;
    }

    match /counters/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /offers/{code} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["code", "label", "description", "active", "percent", "flatOff", "minOrder", "customersOnly"])
        && request.resource.data.code == code
        && request.resource.data.code is string
        && request.resource.data.label is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && request.resource.data.active is bool
        && request.resource.data.percent is int
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100
        && request.resource.data.flatOff is int
        && request.resource.data.flatOff >= 0
        && request.resource.data.minOrder is int
        && request.resource.data.minOrder >= 0
        && request.resource.data.customersOnly is bool;
      allow delete: if isAdmin();
    }

    match /listings/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tickets/{id} {
      allow create: if request.resource.data.status == "open"
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow read, update, delete: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 500
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /customers/{email} {
      allow read: if true;
      allow create, update: if request.resource.data.email is string
        && request.resource.data.orders is int
        && request.resource.data.orders >= 0;
      allow delete: if false;
    }

    match /inventory/{slug} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["stock"])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
      allow delete: if false;
    }
  }
}
